<%- include('../partials/header') %>
<section class="auth-card">
  <a class="brand auth-brand" href="/"><span>✓</span> TaskFlow</a>
  <div class="auth-heading">
    <p class="eyebrow">Chào mừng trở lại</p>
    <h1>Đăng nhập</h1>
    <p>Tiếp tục quản lý công việc của bạn.</p>
  </div>
  <%- include('../partials/errors') %>
  <form method="POST" action="/login" class="form-stack">
    <label>Email
      <input type="email" name="email" value="<%= values.email || '' %>" autocomplete="email" placeholder="ban@example.com" required autofocus>
    </label>
    <label>Mật khẩu
      <input type="password" name="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required>
    </label>
    <button class="btn btn-primary btn-block" type="submit">Đăng nhập</button>
  </form>
  <p class="auth-switch">Chưa có tài khoản? <a href="/register">Đăng ký ngay</a></p>
</section>
<%- include('../partials/footer') %>
