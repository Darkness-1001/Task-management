<%- include('../partials/header') %>
<% const isCreate = method === 'POST'; %>
<nav class="breadcrumbs" aria-label="Đường dẫn">
  <a href="/tasks">Dự án</a><span>/</span><a href="/tasks">TaskFlow</a><span>/</span>
  <% if (isCreate) { %>
    <span>Tạo mới</span>
  <% } else { %>
    <a href="/tasks/<%= task.id %>"><%= taskKey(task.id) %></a><span>/</span><span>Chỉnh sửa</span>
  <% } %>
</nav>

<div class="dialog">
  <header class="dialog-header">
    <h1><%= title %></h1>
    <p class="muted">Các trường có dấu <span class="required">*</span> là bắt buộc.</p>
  </header>
  <%- include('../partials/errors') %>
  <form method="POST" action="<%= formAction %><%= isCreate ? '' : '?_method=' + method %>" class="form-stack">
    <div class="field">
      <label for="title">Tiêu đề <span class="required">*</span></label>
      <input id="title" type="text" name="title" value="<%= task.title || '' %>" maxlength="200" placeholder="Ví dụ: Hoàn thành báo cáo môn học" required autofocus>
    </div>
    <div class="field">
      <label for="description">Mô tả</label>
      <textarea id="description" name="description" rows="7" placeholder="Thêm mô tả chi tiết..."><%= task.description || '' %></textarea>
    </div>
    <div class="form-row">
      <div class="field">
        <label for="status">Trạng thái</label>
        <select id="status" name="status">
          <% Object.entries(STATUS_LABELS).forEach(([key, label]) => { %>
            <option value="<%= key %>" <%= (task.status || 'TODO') === key ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="priority">Ưu tiên</label>
        <select id="priority" name="priority">
          <% Object.entries(PRIORITY_LABELS).forEach(([key, label]) => { %>
            <option value="<%= key %>" <%= (task.priority || 'MEDIUM') === key ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="dueDate">Ngày hết hạn</label>
        <input id="dueDate" type="date" name="dueDate" value="<%= task.dueDate || task.due_date || '' %>">
      </div>
    </div>
    <footer class="dialog-footer">
      <a class="btn btn-link" href="<%= isCreate ? '/tasks' : '/tasks/' + task.id %>">Hủy</a>
      <button class="btn btn-primary" type="submit"><%= isCreate ? 'Tạo' : 'Lưu thay đổi' %></button>
    </footer>
  </form>
</div>
<%- include('../partials/footer') %>
