<% if (flash) { %>
  <div class="flag flag-<%= flash.type %>" role="status" data-flag>
    <span class="flag-icon" aria-hidden="true"><%= flash.type === 'success' ? '✓' : '!' %></span>
    <p><%= flash.message %></p>
    <button type="button" class="flag-close" data-flag-close aria-label="Đóng thông báo">×</button>
  </div>
<% } %>
